<?xml version="1.0" encoding="UTF-8"?>
<!--
  RaceTime QR Timing: a small web app athletes use to check in at a checkpoint by scanning a QR code.

  It is intentionally kept small and dependency-light so it can serve as a readable example of an
  integration with the RaceTime API. Everything the app does is plain Spring Boot:
    * Spring MVC renders server-side pages with FreeMarker templates (no JavaScript is needed).
    * Spring's RestClient talks to the RaceTime API.
    * Bean Validation checks the check-in form.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>app.racetime</groupId>
    <artifactId>qr-timing</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>RaceTime QR Timing</name>
    <description>Self check-in for RaceTime events: athletes scan a checkpoint QR code and enter their bib number.</description>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <!-- Spring MVC: controllers, form binding, embedded Tomcat. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!-- Server-side HTML templates (src/main/resources/templates/*.ftlh). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-freemarker</artifactId>
        </dependency>
        <!-- RestClient, the HTTP client used to call the RaceTime API. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>
        <!-- @NotBlank, @Pattern, ... on the check-in form. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- /actuator/health, used as the Cloud Run startup and liveness probe. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Tests: MockMvc for the pages, MockRestServiceServer for the API client. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-freemarker-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- A fixed jar name keeps the Dockerfile independent of the project version. -->
        <finalName>qr-timing</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
